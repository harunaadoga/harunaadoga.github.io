---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en-GB">
  <title>{{ site.name }} · Writing</title>
  <subtitle>{{ site.description }}</subtitle>
  <link href="{{ '/feed.xml' | absolute(site.url) }}" rel="self"/>
  <link href="{{ site.url }}/"/>
  <updated>{{ collections.posts | getNewestCollectionItemDate | dateToRfc3339 }}</updated>
  <id>{{ site.url }}/</id>
  <author><name>{{ site.name }}</name></author>
  {%- for post in collections.posts | limit(20) %}
  {%- set abs = post.url | absolute(site.url) %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ abs }}"/>
    <updated>{{ post.date | dateToRfc3339 }}</updated>
    <id>{{ abs }}</id>
    <summary>{{ post.data.description }}</summary>
    <content type="html">{{ post.templateContent | renderTransforms(post.data.page, site.url) | escape }}</content>
  </entry>
  {%- endfor %}
</feed>
