{%- macro socials(site, class="socials") -%}
<ul class="{{ class }}">
  {%- for key in ["linkedin", "youtube", "github", "x", "tiktok", "medium"] %}
  {%- if site.social[key] %}
  <li><a href="{{ site.social[key] }}" rel="me noopener" target="_blank" aria-label="{{ {'linkedin':'LinkedIn','youtube':'YouTube','github':'GitHub','x':'X','tiktok':'TikTok','medium':'Medium'}[key] }}">{{ icon(key) }}</a></li>
  {%- endif %}
  {%- endfor %}
</ul>
{%- endmacro -%}
