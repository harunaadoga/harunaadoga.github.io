---
layout: layouts/base.njk
title: Certifications and Education
description: Academic qualifications and professional certifications of Haruna Umar Adoga, PhD, including a PhD in Computing Science from the University of Glasgow and the Red Hat Certified System Administrator (RHCSA).
permalink: /credentials/
---
{% from "partials/icons.njk" import icon %}

<section class="page-head">
  <div class="wrap">
    <p class="eyebrow">Certifications and education</p>
    <h1>Qualifications.</h1>
    <p class="lede">Academic degrees and professional certifications are listed separately. A certification is marked current only where that has been confirmed.</p>
  </div>
</section>

<section class="section section--line" style="padding-top: 40px;">
  <div class="wrap">
    <p class="eyebrow">Academic qualifications</p>
    <table class="table reveal">
      <caption class="sr-only">Academic qualifications</caption>
      <thead><tr><th scope="col">Qualification</th><th scope="col">Institution</th><th scope="col">Years</th></tr></thead>
      <tbody>
        {%- for e in profile.education %}
        <tr>
          <th scope="row">{{ e.award }}{% if e.note %}<span class="table__note">{{ e.note }}</span>{% endif %}</th>
          <td>{{ e.org }}</td>
          <td class="mono">{{ e.period }}</td>
        </tr>
        {%- endfor %}
      </tbody>
    </table>
    <p style="margin-top: 20px;"><a class="link-arrow" href="/research/">Thesis and publications {{ icon("arrow") }}</a></p>
  </div>
</section>

<section class="section section--tint">
  <div class="wrap">
    <p class="eyebrow">Professional certifications</p>
    <table class="table reveal">
      <caption class="sr-only">Professional certifications</caption>
      <thead><tr><th scope="col">Certification</th><th scope="col">Issuer</th><th scope="col">Earned</th><th scope="col">Status</th></tr></thead>
      <tbody>
        {%- for c in profile.certifications %}
        <tr>
          <th scope="row">{{ c.name }}</th>
          <td>{{ c.issuer }}</td>
          <td class="mono">{{ c.year or "–" }}</td>
          <td>{% if c.status %}<span class="badge">{{ c.status }}</span>{% elif site.showPlaceholders %}<span class="badge badge--todo">Date and status to confirm</span>{% else %}–{% endif %}</td>
        </tr>
        {%- endfor %}
      </tbody>
    </table>
    {%- if profile.inProgress.length %}
    <p class="muted" style="margin-top: 20px;">Working towards: {{ profile.inProgress | join(", ") }}.</p>
    {%- endif %}
  </div>
</section>

<section class="section">
  <div class="wrap">
    <p class="eyebrow">Professional memberships</p>
    <table class="table reveal">
      <caption class="sr-only">Professional memberships</caption>
      <thead><tr><th scope="col">Body</th><th scope="col">Name</th><th scope="col">Member since</th></tr></thead>
      <tbody>
        {%- for m in profile.memberships %}
        <tr><th scope="row">{{ m.short }}</th><td>{{ m.name }}</td><td class="mono">{{ m.since }}</td></tr>
        {%- endfor %}
      </tbody>
    </table>
  </div>
</section>
