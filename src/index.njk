---
layout: layouts/base.njk
permalink: /
---
{% from "partials/icons.njk" import icon, socials %}
{% from "partials/cards.njk" import postRow, videoCard, cta %}
{% from "partials/courses.njk" import courseCards %}

<section class="hero">
  <canvas class="hero__canvas" data-topology aria-hidden="true"></canvas>
  <div class="wrap hero__grid">
    <div>
      <h1 class="hero__name">Haruna Umar Adoga, <abbr title="Doctor of Philosophy">PhD</abbr></h1>
      <p class="hero__role">{% for r in site.roleLine %}<span>{{ r }}</span>{% endfor %}</p>
      <p class="lede">I design, build and operate computing infrastructure for research: HPC clusters, parallel storage, private cloud and the high-speed networks that connect them. Fifteen years of engineering, and a PhD in Computing Science from the University of Glasgow.</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="/portfolio/">Explore my work {{ icon("arrow") }}</a>
        <a class="btn btn--ghost" href="/experience/">Professional experience</a>
        <a class="btn btn--ghost" href="/cv/">Download CV</a>
        <a class="btn btn--ghost" href="/contact/">Get in touch</a>
      </div>
      {{ socials(site) }}
    </div>
    <div class="portrait">
      <div class="portrait__frame">
        <img src="/assets/img/haruna.webp" alt="Portrait of Haruna Umar Adoga" width="900" height="900" fetchpriority="high">
      </div>
      <div class="portrait__card">
        <strong>Haruna Umar Adoga, PhD</strong>
        <span>PhD, University of Glasgow<br>Member of IEEE, BCS and IET</span>
      </div>
    </div>
  </div>
</section>

<div class="wrap">
  <div class="stats">
    {%- for s in profile.stats %}
    <div class="stat reveal" style="--d: {{ loop.index0 * 80 }}ms">
      <div class="stat__value">{% if s.value is number %}<span data-count="{{ s.value }}">{{ s.value }}</span>{% else %}{{ s.value }}{% endif %}{{ s.suffix }}</div>
      <p class="stat__label">{{ s.label }}</p>
    </div>
    {%- endfor %}
  </div>
</div>

<section class="section">
  <div class="wrap">
    <div class="section__head reveal">
      <div>
        <p class="eyebrow">Technical expertise</p>
        <h2>Infrastructure for research, from the rack to the scheduler.</h2>
      </div>
      <a class="link-arrow" href="/experience/">Professional experience {{ icon("arrow") }}</a>
    </div>
    <div class="grid grid--4">
      {%- for f in profile.focus %}
      <article class="card reveal" style="--d: {{ loop.index0 * 70 }}ms">
        <div class="card__num">0{{ loop.index }}</div>
        <h3>{{ f.title }}</h3>
        <p>{{ f.body }}</p>
        <ul class="chips">{% for t in f.tags %}<li class="chip">{{ t }}</li>{% endfor %}</ul>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section section--tint">
  <div class="wrap">
    <div class="section__head reveal">
      <div>
        <p class="eyebrow">Selected projects</p>
        <h2>Production systems, open labs and research.</h2>
      </div>
      <a class="link-arrow" href="/portfolio/">Full portfolio {{ icon("arrow") }}</a>
    </div>
    <ul class="feature-list reveal">
      {%- for c in portfolio.categories %}{% for p in c.projects %}{% if p.featured %}
      <li>
        <span class="feature-list__cat">{{ c.title }}</span>
        <div>
          <h3><a href="/portfolio/#{{ c.id }}">{{ p.title }}</a></h3>
          <p>{{ p.overview }}</p>
        </div>
        <span class="feature-list__arrow" aria-hidden="true">{{ icon("arrow") }}</span>
      </li>
      {%- endif %}{% endfor %}{% endfor %}
    </ul>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section__head reveal">
      <div>
        <p class="eyebrow">Linux education</p>
        <h2>Free courses, with labs and video.</h2>
      </div>
      <a class="link-arrow" href="/learn/">All teaching {{ icon("arrow") }}</a>
    </div>
    {{ courseCards(rhcsa, hardening) }}
  </div>
</section>

<section class="section section--tint">
  <div class="wrap">
    <div class="section__head reveal">
      <div>
        <p class="eyebrow">Technical blog</p>
        <h2>Notes from the machine room and the lab.</h2>
      </div>
      <a class="link-arrow" href="/writing/">All articles {{ icon("arrow") }}</a>
    </div>
    <ul class="post-list reveal">
      {%- for post in collections.posts | limit(3) %}
      {{ postRow(post) }}
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="section section--line">
  <div class="wrap grid grid--2" style="gap: clamp(32px, 6vw, 80px); align-items: start;">
    <div class="reveal">
      <p class="eyebrow">Research</p>
      <h2>Placing network functions where latency is lowest.</h2>
      <p class="lede">My doctoral research at Glasgow looked at how to run chains of virtual network functions across very different hosts at the network edge, from containers to programmable switches, and still keep latency promises.</p>
      <p><a class="link-arrow" href="/research/">Thesis and publications {{ icon("arrow") }}</a></p>
    </div>
    <div class="reveal" style="--d: 120ms">
      {%- for p in profile.research.publications | limit(3) %}
      <article class="pub" style="grid-template-columns: 64px minmax(0, 1fr); gap: 8px 20px;">
        <div class="pub__year">{{ p.year }}</div>
        <div>
          <h3 style="font-size: 1.12rem;"><a href="https://doi.org/{{ p.doi }}" target="_blank" rel="noopener">{{ p.title }}</a></h3>
          <p class="muted">{{ p.venue }}</p>
        </div>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>

{{ cta(site, "Let's talk.", "Senior engineering roles, research collaboration, consulting and training.") }}
