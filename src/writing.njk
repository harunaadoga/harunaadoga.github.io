---
layout: layouts/base.njk
title: Technical Blog
description: Technical blog by Haruna Umar Adoga, PhD. Articles on Linux, HPC, OpenStack, networking, storage, automation, cybersecurity and research computing.
permalink: /writing/
---
{% from "partials/icons.njk" import icon %}
{% from "partials/cards.njk" import postRow %}

<section class="page-head">
  <div class="wrap">
    <p class="eyebrow">Technical blog</p>
    <h1>Engineering notes, tutorials and field reports.</h1>
    <p class="lede">How-to guides, what I learn at conferences, new technology I am testing, research explained plainly, and advice for people building a career in infrastructure.</p>
  </div>
</section>

<section class="section" style="padding-top: 0;">
  <div class="wrap">
    <div class="toolbar">
      <ul class="chips" aria-label="Filter by topic">
        {%- for t in collections.topics %}
        <li><button class="chip" type="button" data-topic="{{ t.name }}" aria-pressed="false">{{ t.name }} · {{ t.count }}</button></li>
        {%- endfor %}
      </ul>
      <div class="search">
        <label class="skip" for="post-search">Search posts</label>
        <input id="post-search" type="search" placeholder="Search posts (press /)" data-post-search autocomplete="off">
      </div>
    </div>
    <p class="meta"><span data-post-count>{{ collections.posts.length }} posts</span><a href="/feed.xml">Subscribe via RSS</a></p>
    <ul class="post-list" data-post-list>
      {%- for post in collections.posts %}
      {{ postRow(post) }}
      {%- endfor %}
    </ul>
    <p class="empty" data-post-empty hidden>No posts match that search yet.</p>
  </div>
</section>
